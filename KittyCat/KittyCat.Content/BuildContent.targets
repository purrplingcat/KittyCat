<Project>
  <Target Name="BuildContent" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <ContentOutput>$(ProjectDir)$(OutputPath)</ContentOutput>
      <ContentTemp>$(ProjectDir)$(IntermediateOutputPath)\ContentBuilder</ContentTemp>
      <ContentCreatePak Condition="'$(ContentCreatePak)' == ''">true</ContentCreatePak>
      <ContentArgs>--ContentBuilder:Platform=$(MonoGamePlatform) --ContentBuilder:SourceDirectory=&quot;$(MSBuildThisFileDirectory)Assets&quot; --ContentBuilder:OutputDirectory=&quot;$(ContentOutput)/.&quot; --ContentBuilder:IntermediateDirectory=&quot;$(ContentTemp)/.&quot; --ContentBuilder:CreatePak=$(ContentCreatePak)</ContentArgs>
      <ContentCommand>$(MSBuildThisFileDirectory)bin\Debug\KittyCat.Content</ContentCommand>
    </PropertyGroup>
    <!-- Build-time File.IO is valid here; runtime enumerates bundled package assets via IFileProvider. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)KittyCat.Content.csproj" Targets="Build" RemoveProperties="Configuration;TargetFramework;RuntimeIdentifier;RuntimeIdentifiers" />
	<Exec Command="$(ContentCommand) $(ContentArgs)" WorkingDirectory="$(MSBuildThisFileDirectory)..\" CustomErrorRegularExpression="\[E\] .+" CustomWarningRegularExpression="\[W\] .+" />
   </Target>
  <Target Name="AddGeneratedContentAssets" AfterTargets="BuildContent" BeforeTargets="_CreateBaseApk">
    <ItemGroup>
      <!-- Include generated PAKs in APK assets or Apple bundled resources. -->
      <GeneratedAsset Include="$(ContentOutput)Content\**\*" />
      <BundledResource Include="@(GeneratedAsset)"
        Condition="'$(MonoGamePlatform)' == 'MacOSX' Or '$(MonoGamePlatform)' == 'iOS'">
        <Link>Content\%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</Link>
      </BundledResource>
    </ItemGroup>
  </Target>
</Project>