{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build KittyCat DesktopGL (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/KittyCat/KittyCat.DesktopGL/KittyCat.DesktopGL.csproj",
        "--configuration",
        "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build KittyCat DesktopGL (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/KittyCat/KittyCat.DesktopGL/KittyCat.DesktopGL.csproj",
        "--configuration",
        "Release"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
